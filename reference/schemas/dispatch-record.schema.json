{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teo.example/schemas/dispatch-record.schema.json",
  "title": "TEO Dispatch Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id", "dispatch_id", "created_at", "task", "task_type", "risk_level",
    "selected_team", "selected_worker", "selected_specialist", "specialist_source",
    "specialist_risk_profile", "required_capabilities", "selected_implementation",
    "fallback_implementation", "verification", "routing_explanation", "warnings", "status"
  ],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "dispatch_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "task": {"type": "string", "minLength": 1},
    "task_type": {"type": "string", "minLength": 1},
    "risk_level": {"enum": ["low", "medium", "high", "critical"]},
    "selected_team": {"type": "string", "minLength": 1},
    "selected_worker": {"type": "string", "minLength": 1},
    "selected_specialist": {"type": ["string", "null"]},
    "specialist_source": {"type": ["string", "null"]},
    "specialist_risk_profile": {"type": ["string", "null"]},
    "required_capabilities": {"type": "array", "items": {"type": "string"}},
    "selected_implementation": {"$ref": "#/$defs/implementation"},
    "fallback_implementation": {"oneOf": [{"$ref": "#/$defs/implementation"}, {"type": "null"}]},
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["team", "method", "implementation", "independent", "human_approval_required"],
      "properties": {
        "team": {"type": "string", "minLength": 1},
        "method": {"type": "array", "items": {"type": "string"}},
        "implementation": {"$ref": "#/$defs/implementation"},
        "independent": {"const": true},
        "human_approval_required": {"type": "boolean"}
      }
    },
    "routing_explanation": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "status": {"const": "dispatched"}
  },
  "$defs": {
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "model", "profile", "provider_family", "availability", "source", "reasoning"],
      "properties": {
        "agent": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "profile": {"type": ["string", "null"]},
        "provider_family": {"type": ["string", "null"]},
        "availability": {"type": ["string", "null"]},
        "source": {"type": "string", "minLength": 1},
        "reasoning": {"type": ["string", "null"]}
      }
    }
  }
}
