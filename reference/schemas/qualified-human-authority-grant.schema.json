{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teo.example/schemas/qualified-human-authority-grant.schema.json",
  "title": "TEO Qualified-Human Authority Grant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "qualified_human_approval_version",
    "record_type",
    "grant_id",
    "issued_at",
    "valid_from",
    "valid_until",
    "subject_type",
    "subject_ref",
    "authority_class",
    "scope",
    "source",
    "identity_is_routing_signal",
    "model_selection_is_qualification_signal",
    "provider_access_is_qualification_signal",
    "billing_identity_is_qualification_signal",
    "integrity_sha256"
  ],
  "properties": {
    "qualified_human_approval_version": {"const": "1"},
    "record_type": {"const": "qualified_human_authority_grant"},
    "grant_id": {"type": "string", "pattern": "^authority-grant-[a-f0-9]{20}$"},
    "issued_at": {"type": "string", "format": "date-time"},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": ["string", "null"], "format": "date-time"},
    "subject_type": {"const": "human"},
    "subject_ref": {"type": "string", "minLength": 1},
    "authority_class": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_requirement_ids", "risk_levels", "task_types"],
      "properties": {
        "authority_requirement_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "risk_levels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["low", "medium", "high", "critical"]}
        },
        "task_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "evidence_ref", "verified_at"],
      "properties": {
        "issuer": {"type": "string", "minLength": 1},
        "evidence_ref": {"type": "string", "minLength": 1},
        "verified_at": {"type": "string", "format": "date-time"}
      }
    },
    "identity_is_routing_signal": {"const": false},
    "model_selection_is_qualification_signal": {"const": false},
    "provider_access_is_qualification_signal": {"const": false},
    "billing_identity_is_qualification_signal": {"const": false},
    "integrity_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}