{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teo.example/schemas/verification-result.schema.json",
  "title": "TEO Verification Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["dispatch_id", "status", "verifier_model"],
  "properties": {
    "dispatch_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["passed", "failed", "needs_human"]},
    "verifier_model": {"type": "string", "minLength": 1},
    "checks": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": ["string", "null"]},
    "verified_artifact": {
      "type": ["object", "null"],
      "properties": {
        "output_ref": {"type": "string", "minLength": 1, "pattern": "^file://"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0}
      },
      "required": ["output_ref", "sha256", "size_bytes"],
      "additionalProperties": false
    }
  }
}
