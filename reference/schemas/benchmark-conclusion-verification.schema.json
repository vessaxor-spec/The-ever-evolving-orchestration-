{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teo.example/schemas/benchmark-conclusion-verification.schema.json",
  "title": "TEO Benchmark Conclusion Independent Verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_lab_version",
    "record_type",
    "verification_id",
    "verified_at",
    "conclusion_id",
    "conclusion_integrity_sha256",
    "report_integrity_sha256",
    "verifier",
    "independent",
    "decision",
    "checks",
    "human_reason",
    "evidence",
    "integrity_sha256"
  ],
  "properties": {
    "benchmark_lab_version": {"const": "1"},
    "record_type": {"const": "benchmark_conclusion_verification"},
    "verification_id": {"type": "string", "pattern": "^conclusion-verification-[0-9a-f]{20}$"},
    "verified_at": {"type": "string", "format": "date-time"},
    "conclusion_id": {"type": "string", "pattern": "^conclusion-[0-9a-f]{20}$"},
    "conclusion_integrity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "report_integrity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_type", "actor_id", "provider_family", "model"],
      "properties": {
        "actor_type": {"enum": ["specialist", "human"]},
        "actor_id": {"type": "string", "minLength": 1},
        "provider_family": {"type": ["string", "null"], "minLength": 1},
        "model": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "independent": {"const": true},
    "decision": {"enum": ["verified", "rejected", "needs_human"]},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_support",
        "uncertainty_preserved",
        "authority_boundary_preserved",
        "unsupported_causality_absent"
      ],
      "properties": {
        "evidence_support": {"enum": ["pass", "fail", "uncertain"]},
        "uncertainty_preserved": {"enum": ["pass", "fail", "uncertain"]},
        "authority_boundary_preserved": {"enum": ["pass", "fail", "uncertain"]},
        "unsupported_causality_absent": {"enum": ["pass", "fail", "uncertain"]}
      }
    },
    "human_reason": {
      "enum": [
        "none",
        "insufficient_evidence",
        "conflicting_evidence",
        "scope_ambiguity",
        "authority_concern"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "integrity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
