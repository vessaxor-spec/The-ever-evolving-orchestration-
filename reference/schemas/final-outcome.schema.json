{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teo.example/schemas/final-outcome.schema.json",
  "title": "TEO Final Outcome",
  "type": "object",
  "required": [
    "dispatch_id", "task_id", "completed_at", "status", "execution_status",
    "verification_status", "selected_model", "verifier_model", "evidence",
    "failed_attempts", "escalation_used", "notes"
  ],
  "properties": {
    "dispatch_id": {"type": "string"},
    "task_id": {"type": "string"},
    "completed_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["completed", "failed", "escalated", "awaiting_human"]},
    "execution_status": {"enum": ["succeeded", "failed"]},
    "verification_status": {"enum": ["passed", "failed", "needs_human"]},
    "selected_model": {"type": "string"},
    "verifier_model": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "failed_attempts": {"type": "integer", "minimum": 0},
    "escalation_used": {"type": "boolean"},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
