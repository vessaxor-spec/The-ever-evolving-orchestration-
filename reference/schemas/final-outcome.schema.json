{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teo.example/schemas/final-outcome.schema.json",
  "title": "TEO Final Outcome",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dispatch_id", "task_id", "completed_at", "status", "execution_status",
    "verification_status", "selected_model", "verifier_model", "evidence",
    "failed_attempts", "escalation_used", "notes"
  ],
  "properties": {
    "dispatch_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "completed_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["completed", "failed", "escalated", "awaiting_human"]},
    "execution_status": {"enum": ["succeeded", "failed"]},
    "verification_status": {"enum": ["passed", "failed", "needs_human"]},
    "selected_model": {"type": "string", "minLength": 1},
    "verifier_model": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "failed_attempts": {"type": "integer", "minimum": 0},
    "escalation_used": {"type": "boolean"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "execution_provenance": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "route_outcome_id",
            "route_outcome_integrity_sha256",
            "active_dispatch_id",
            "active_route_role",
            "provider_family",
            "model",
            "reasoning_effort",
            "verification_dispatch_id",
            "final_disposition",
            "fallback_assisted",
            "retry_assisted"
          ],
          "properties": {
            "source": {"const": "route_outcome"},
            "route_outcome_id": {"type": "string", "pattern": "^outcome-[a-f0-9]{20}$"},
            "route_outcome_integrity_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "active_dispatch_id": {"type": "string", "minLength": 1},
            "active_route_role": {"enum": ["primary", "fallback"]},
            "provider_family": {"type": "string", "minLength": 1},
            "model": {"type": "string", "minLength": 1},
            "reasoning_effort": {
              "oneOf": [
                {"type": "null"},
                {"enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max"]}
              ]
            },
            "verification_dispatch_id": {"type": "string", "minLength": 1},
            "final_disposition": {"enum": ["completed", "verification_failed", "awaiting_human"]},
            "fallback_assisted": {"type": "boolean"},
            "retry_assisted": {"type": "boolean"}
          }
        }
      ]
    }
  }
}
