{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teo.example/schemas/shadow-evaluation-input.schema.json",
  "title": "TEO Shadow Route Evaluation Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "shadow_evaluation_version",
    "record_type",
    "evaluation_id",
    "created_at",
    "specialist_id",
    "question",
    "consequence_level",
    "candidate_id",
    "baseline_candidate_id",
    "decision_owner",
    "decision_dimensions",
    "evidence_refs",
    "policy_write_authority",
    "live_routing_authority",
    "qualified_human_approval_satisfied",
    "integrity_sha256"
  ],
  "properties": {
    "shadow_evaluation_version": {"const": "1"},
    "record_type": {"const": "shadow_evaluation_input"},
    "evaluation_id": {"type": "string", "pattern": "^shadow-input-[a-f0-9]{20}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "specialist_id": {"const": "orchestration-evaluation-analyst"},
    "question": {"type": "string", "minLength": 1},
    "consequence_level": {"enum": ["routine", "consequential"]},
    "candidate_id": {"type": "string", "minLength": 1},
    "baseline_candidate_id": {"type": "string", "minLength": 1},
    "decision_owner": {"const": "mission_control_or_maintainer_review"},
    "decision_dimensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "verified_quality",
          "primary_reliability",
          "retry_dependence",
          "fallback_dependence",
          "verifier_disagreement",
          "latency",
          "source_backed_cost"
        ]
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 4,
      "items": {"$ref": "#/$defs/evidenceRef"}
    },
    "policy_write_authority": {"const": false},
    "live_routing_authority": {"const": false},
    "qualified_human_approval_satisfied": {"const": false},
    "integrity_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "record_id", "integrity_sha256"],
      "properties": {
        "record_type": {
          "enum": [
            "benchmark_experiment",
            "benchmark_report",
            "benchmark_conclusion_handoff",
            "route_outcome",
            "route_cost_attribution"
          ]
        },
        "record_id": {"type": "string", "minLength": 1},
        "integrity_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}