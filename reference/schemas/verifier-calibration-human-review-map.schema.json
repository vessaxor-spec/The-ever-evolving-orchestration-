{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teo.example/schemas/verifier-calibration-human-review-map.schema.json",
  "title": "TEO Verifier Calibration Private Human Review Map",
  "type": "object",
  "additionalProperties": false,
  "required": ["packet_id", "rubric_version", "items"],
  "properties": {
    "packet_id": {"type": "string", "minLength": 8},
    "rubric_version": {"type": "string", "minLength": 1},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["review_item_id", "case_id"],
        "properties": {
          "review_item_id": {"type": "string", "minLength": 8},
          "case_id": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}