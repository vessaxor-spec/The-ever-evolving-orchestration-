{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teo.example/schemas/route-cost-attribution.schema.json",
  "title": "TEO Route Cost Attribution Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cost_attribution_version",
    "record_type",
    "attribution_id",
    "attributed_at",
    "outcome_id",
    "outcome_integrity_sha256",
    "currency",
    "status",
    "primary_route",
    "fallback_route",
    "verifier",
    "total_amount",
    "pricing_evidence_ids",
    "issues",
    "integrity_sha256"
  ],
  "properties": {
    "cost_attribution_version": {"const": "1"},
    "record_type": {"const": "route_cost_attribution"},
    "attribution_id": {"type": "string", "pattern": "^cost-[a-f0-9]{20}$"},
    "attributed_at": {"type": "string", "format": "date-time"},
    "outcome_id": {"type": "string", "pattern": "^outcome-[a-f0-9]{20}$"},
    "outcome_integrity_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "currency": {"const": "USD"},
    "status": {"enum": ["known", "partial", "unknown"]},
    "primary_route": {"$ref": "#/$defs/routeCost"},
    "fallback_route": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/routeCost"}
      ]
    },
    "verifier": {"$ref": "#/$defs/verifierCost"},
    "total_amount": {"$ref": "#/$defs/decimalOrNull"},
    "pricing_evidence_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^pricing-[a-z0-9][a-z0-9._-]{2,127}$"},
      "uniqueItems": true
    },
    "issues": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "integrity_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "decimalOrNull": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"}
      ]
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "cached_input_tokens",
        "cache_creation_input_tokens",
        "reasoning_output_tokens",
        "tool_tokens",
        "total_tokens"
      ],
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cache_creation_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "reasoning_output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "tool_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quantity_tokens", "rate_per_1m", "amount"],
      "properties": {
        "quantity_tokens": {"type": "integer", "minimum": 0},
        "rate_per_1m": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
        "amount": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"}
      }
    },
    "attemptCost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_number",
        "recorded_at",
        "provider_family",
        "model",
        "billable_surface",
        "additional_billable_events_status",
        "status",
        "usage",
        "pricing_evidence_id",
        "components",
        "amount",
        "issues"
      ],
      "properties": {
        "attempt_number": {"type": "integer", "minimum": 1},
        "recorded_at": {"type": "string", "format": "date-time"},
        "provider_family": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "billable_surface": {"type": ["string", "null"], "minLength": 1},
        "additional_billable_events_status": {"enum": ["none", "unknown"]},
        "status": {"enum": ["known", "unknown"]},
        "usage": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/usage"}
          ]
        },
        "pricing_evidence_id": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^pricing-[a-z0-9][a-z0-9._-]{2,127}$"}
          ]
        },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": ["uncached_input", "cached_input", "cache_write_input", "output"],
          "properties": {
            "uncached_input": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/component"}]},
            "cached_input": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/component"}]},
            "cache_write_input": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/component"}]},
            "output": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/component"}]}
          }
        },
        "amount": {"$ref": "#/$defs/decimalOrNull"},
        "issues": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "routeCost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dispatch_id", "role", "status", "attempts", "amount", "issues"],
      "properties": {
        "dispatch_id": {"type": "string", "minLength": 1},
        "role": {"enum": ["primary", "fallback"]},
        "status": {"enum": ["known", "partial", "unknown"]},
        "attempts": {"type": "array", "items": {"$ref": "#/$defs/attemptCost"}},
        "amount": {"$ref": "#/$defs/decimalOrNull"},
        "issues": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "verifierCost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dispatch_id",
        "provider_family",
        "model",
        "recorded_at",
        "billable_surface",
        "additional_billable_events_status",
        "status",
        "usage",
        "pricing_evidence_id",
        "components",
        "amount",
        "issues"
      ],
      "properties": {
        "dispatch_id": {"type": ["string", "null"], "minLength": 1},
        "provider_family": {"type": ["string", "null"], "minLength": 1},
        "model": {"type": ["string", "null"], "minLength": 1},
        "recorded_at": {"type": ["string", "null"], "format": "date-time"},
        "billable_surface": {"type": ["string", "null"], "minLength": 1},
        "additional_billable_events_status": {"enum": ["none", "unknown"]},
        "status": {"enum": ["known", "unknown", "not_performed"]},
        "usage": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/usage"}
          ]
        },
        "pricing_evidence_id": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^pricing-[a-z0-9][a-z0-9._-]{2,127}$"}
          ]
        },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": ["uncached_input", "cached_input", "cache_write_input", "output"],
          "properties": {
            "uncached_input": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/component"}]},
            "cached_input": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/component"}]},
            "cache_write_input": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/component"}]},
            "output": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/component"}]}
          }
        },
        "amount": {"$ref": "#/$defs/decimalOrNull"},
        "issues": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    }
  }
}
