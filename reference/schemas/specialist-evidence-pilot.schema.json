{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teo.example/schemas/specialist-evidence-pilot.schema.json",
  "title": "TEO Regulated Specialist Evidence Pilot",
  "type": "object",
  "required": ["version", "status", "reviewed_at", "controls", "pilot_specialists"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "number", "const": 0.2},
    "status": {"type": "string", "const": "pilot"},
    "reviewed_at": {"type": "string", "format": "date"},
    "purpose": {"type": "string", "minLength": 1},
    "controls": {
      "type": "object",
      "required": [
        "consequential_use_requires_unexpired_evidence",
        "high_and_critical_require_independent_verification",
        "stale_or_unavailable_behavior",
        "conflicting_authorities_behavior",
        "source_resolution_cadence_days"
      ],
      "additionalProperties": false,
      "properties": {
        "consequential_use_requires_unexpired_evidence": {"const": true},
        "high_and_critical_require_independent_verification": {"const": true},
        "stale_or_unavailable_behavior": {"const": "refuse_consequential_claim"},
        "conflicting_authorities_behavior": {"const": "escalate_and_present_conflict"},
        "source_resolution_cadence_days": {"type": "integer", "minimum": 1, "maximum": 30}
      }
    },
    "pilot_specialists": {
      "type": "object",
      "minProperties": 6,
      "maxProperties": 6,
      "required": [
        "legal-operations",
        "tax-strategist",
        "loan-officer-assistant",
        "compliance-auditor",
        "civil-engineer",
        "embedded-engineer"
      ],
      "additionalProperties": {"$ref": "#/$defs/specialist"}
    }
  },
  "$defs": {
    "specialist": {
      "type": "object",
      "required": ["card_path", "canonical_blob_sha", "risk_tier", "claims"],
      "additionalProperties": false,
      "properties": {
        "card_path": {"type": "string", "pattern": "^community/specialists/.+\\.md$"},
        "canonical_blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "risk_tier": {"enum": ["high", "critical"]},
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/claim"}
        }
      }
    },
    "claim": {
      "type": "object",
      "required": [
        "id",
        "statement",
        "volatility_class",
        "consequential_use",
        "applicability",
        "authority",
        "verified_at",
        "expires_at",
        "verification",
        "required_behavior"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 20},
        "volatility_class": {"enum": ["slow_moving", "fast_moving", "highly_volatile"]},
        "consequential_use": {"const": true},
        "applicability": {
          "type": "object",
          "required": ["jurisdiction", "scope"],
          "additionalProperties": false,
          "properties": {
            "jurisdiction": {"type": "string", "minLength": 1},
            "scope": {"type": "string", "minLength": 1}
          }
        },
        "authority": {
          "type": "object",
          "required": [
            "tier",
            "organization",
            "source_type",
            "url",
            "expected_hosts",
            "locator",
            "source_date_basis",
            "source_date"
          ],
          "additionalProperties": false,
          "properties": {
            "tier": {"const": 1},
            "organization": {"type": "string", "minLength": 1},
            "source_type": {"enum": ["regulator", "standards_body", "primary_law", "official_vendor_documentation", "official_release_notes"]},
            "url": {"type": "string", "pattern": "^https://"},
            "expected_hosts": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "locator": {"type": "string", "minLength": 1},
            "source_date_basis": {"enum": ["published", "effective", "last_updated", "observed"]},
            "source_date": {"type": "string", "format": "date"}
          }
        },
        "verified_at": {"type": "string", "format": "date"},
        "expires_at": {"type": "string", "format": "date"},
        "verification": {
          "type": "object",
          "required": ["prepared_by", "verified_by", "independent"],
          "additionalProperties": false,
          "properties": {
            "prepared_by": {"type": "string", "minLength": 1},
            "verified_by": {"type": "string", "minLength": 1},
            "independent": {"const": true}
          }
        },
        "required_behavior": {
          "type": "object",
          "required": ["stale_or_unavailable", "conflict"],
          "additionalProperties": false,
          "properties": {
            "stale_or_unavailable": {"const": "refuse_consequential_claim"},
            "conflict": {"const": "escalate_and_present_conflict"}
          }
        }
      }
    }
  }
}
