{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teo.example/schemas/execution-result.schema.json",
  "title": "TEO Execution Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["dispatch_id", "status"],
  "properties": {
    "dispatch_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["succeeded", "failed"]},
    "output_ref": {"type": ["string", "null"]},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "failed_attempts": {"type": "integer", "minimum": 0},
    "observed_identity": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider_family",
            "model",
            "source",
            "model_observed",
            "configuration_fingerprint",
            "configuration_observed"
          ],
          "properties": {
            "provider_family": {"type": "string", "minLength": 1},
            "model": {"type": "string", "minLength": 1},
            "source": {
              "enum": [
                "provider_response",
                "provider_adapter",
                "verifier_response",
                "verifier_adapter"
              ]
            },
            "model_observed": {"type": "boolean"},
            "configuration_fingerprint": {
              "oneOf": [
                {"type": "null"},
                {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              ]
            },
            "configuration_observed": {"type": "boolean"}
          }
        }
      ]
    }
  }
}
