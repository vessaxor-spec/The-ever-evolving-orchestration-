{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teo.example/schemas/live-scope-replay-plan.schema.json",
  "title": "TEO Live Scope Candidate Replay Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "replay_version",
    "record_type",
    "replay_id",
    "task_type",
    "suite_id",
    "suite_version",
    "trials_per_fixture",
    "fixtures",
    "harness",
    "versions"
  ],
  "properties": {
    "replay_version": {"const": "1"},
    "record_type": {"const": "live_scope_replay_plan"},
    "replay_id": {"type": "string", "minLength": 1},
    "task_type": {"const": "documentation"},
    "suite_id": {"type": "string", "minLength": 1},
    "suite_version": {"type": "string", "minLength": 1},
    "trials_per_fixture": {"type": "integer", "minimum": 1, "maximum": 5},
    "fixtures": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixture_id",
          "risk_level",
          "task",
          "required_capabilities"
        ],
        "properties": {
          "fixture_id": {"type": "string", "minLength": 1},
          "risk_level": {"enum": ["low", "medium"]},
          "task": {"type": "string", "minLength": 1, "maxLength": 4000},
          "required_capabilities": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "harness_id",
        "harness_version",
        "tool_access_profile",
        "max_attempts",
        "selection_mode",
        "circuit_state_profile",
        "verification_mode",
        "authority_mode",
        "fallback_mode"
      ],
      "properties": {
        "harness_id": {"const": "teo-staged-live-scope-replay"},
        "harness_version": {"const": "1"},
        "tool_access_profile": {"const": "none"},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 2},
        "selection_mode": {"const": "canonical_candidate_route"},
        "circuit_state_profile": {"const": "isolated_per_trial"},
        "verification_mode": {"const": "assigned_candidate_verifier"},
        "authority_mode": {"const": "staged_evidence_only"},
        "fallback_mode": {"const": "disabled_until_recovery_gate"}
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_version",
        "repository_revision",
        "routing_policy_revision",
        "registry_revision",
        "tool_versions"
      ],
      "properties": {
        "runtime_version": {"type": "string", "minLength": 1},
        "repository_revision": {"type": "string", "minLength": 1},
        "routing_policy_revision": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "registry_revision": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "tool_versions": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "null"]
          }
        }
      }
    }
  }
}
